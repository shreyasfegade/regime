profile_default/
ipython_config.py

# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this can be ignored:
# .python-version

# pipenv
#   According to pypa/pipenv#1291, pipenv creates files in the project directory
#   that should be ignored when using version control.
#   .venv should be ignored.
#   Pipfile.lock is generally recommended to be committed for apps, but ignored for libraries.
#   We ignore the virtualenv folder:
.venv/
venv/
ENV/
env/

# Poetry
#   Poetry creates a virtualenv in the project directory if configured to do so:
# .venv

# pdm
#   PDM stores project-wide configurations in .pdm.toml:
.pdm.toml
#   PDM regional and volatile data:
.pdm-plugins/
.pdm-build/

# pipx
.pipx/

# ruff
.ruff_cache/

